powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Install-PackageProvider -Name NuGet -Force; Set-PSRepository -Name PSGallery -InstallationPolicy Trusted -ErrorAction SilentlyContinue; Install-Script -Name winget-install -Force; & 'C:\Program Files\WindowsPowerShell\Scripts\winget-install.ps1'"

cmd /c winget update Notepad++.Notepad++ Microsoft.Azure.DataStudio Google.Chrome.EXE --silent --accept-package-agreements --accept-source-agreements --disable-interactivity

powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -Command "$out = winget list 'Acrobat Reader' --accept-source-agreements --disable-interactivity 2>&1 | Out-String; $acrobat = $out -split '\r?\n' | Where-Object { $_ -match 'Acrobat' }; if ($acrobat) { $acrobat | Where-Object { $_ -notmatch 'winget\s*$' } | ForEach-Object { $id = ($_ -split '\s{2,}')[1]; if ($id) { winget uninstall --id $id --silent --accept-source-agreements --disable-interactivity | Out-Null } }; if ($acrobat -match 'winget\s*$') { winget upgrade --id Adobe.Acrobat.Reader.64-bit --exact --silent --accept-package-agreements --accept-source-agreements --disable-interactivity } else { winget install --id Adobe.Acrobat.Reader.64-bit --exact --silent --accept-package-agreements --accept-source-agreements --disable-interactivity } }"
